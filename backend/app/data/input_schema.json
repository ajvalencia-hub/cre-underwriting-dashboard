{
  "version": 1,
  "dealTypes": ["acquisition", "development"],
  "dealStages": {
    "acquisition": ["screening", "underwriting", "loi", "under_contract", "closed", "dead"],
    "development": ["screening", "feasibility", "site_control", "entitlements", "pre_construction", "construction", "lease_up", "stabilized", "dead"]
  },
  "propertyTypes": [
    "multifamily", "single_family", "townhouse", "retail",
    "industrial", "hotel", "office", "mixed_use", "other"
  ],
  "outputs": [
    { "id": "unleveredIrr", "label": "Unlevered IRR", "type": "percent", "group": "Returns" },
    { "id": "leveredIrr", "label": "Levered IRR", "type": "percent", "group": "Returns" },
    { "id": "lpIrr", "label": "LP IRR", "type": "percent", "group": "Returns" },
    { "id": "gpIrr", "label": "GP IRR", "type": "percent", "group": "Returns" },
    { "id": "equityMultiple", "label": "Equity Multiple", "type": "multiple", "group": "Returns" },
    { "id": "unleveredEquityMultiple", "label": "Unlevered Equity Multiple", "type": "multiple", "group": "Returns" },
    { "id": "lpEquityMultiple", "label": "LP Equity Multiple", "type": "multiple", "group": "Returns" },
    { "id": "moic", "label": "MOIC", "type": "multiple", "group": "Returns" },
    { "id": "avgCashOnCash", "label": "Avg Cash-on-Cash", "type": "percent", "group": "Returns" },
    { "id": "cashOnCashYear1", "label": "Year 1 Cash-on-Cash", "type": "percent", "group": "Returns" },
    { "id": "stabilizedCashOnCash", "label": "Stabilized Cash-on-Cash", "type": "percent", "group": "Returns" },
    { "id": "annualizedReturn", "label": "Annualized Return", "type": "percent", "group": "Returns" },
    { "id": "paybackPeriodYears", "label": "Payback Period", "type": "years", "group": "Returns" },

    { "id": "goingInCapRate", "label": "Going-In Cap Rate", "type": "percent", "group": "Yield & Value" },
    { "id": "yieldOnCost", "label": "Yield on Cost (untrended — today's rents)", "type": "percent", "group": "Yield & Value" },
    { "id": "postRenoAvgRent", "label": "Post-Reno Avg Rent (unit/mo)", "type": "currency", "group": "Yield & Value" },
    { "id": "year1LossToLease", "label": "Year-1 Loss to Lease", "type": "currency", "group": "Yield & Value" },
    { "id": "gpFeesTotal", "label": "GP Fees (acq + dev + AM)", "type": "currency", "group": "Returns" },
    { "id": "gpTotalCompensation", "label": "GP Total Compensation", "type": "currency", "group": "Returns" },
    { "id": "combinedLtv", "label": "Combined LTV (senior + tranche)", "type": "percent", "group": "Debt & Leverage" },
    { "id": "combinedLtc", "label": "Combined LTC (senior + tranche)", "type": "percent", "group": "Debt & Leverage" },
    { "id": "developmentSpreadBps", "label": "Development Spread (over exit cap)", "type": "percent", "group": "Yield & Value" },
    { "id": "residentialYieldOnCost", "label": "Residential Yield on Cost", "type": "percent", "group": "Yield & Value" },
    { "id": "commercialYieldOnCost", "label": "Commercial Yield on Cost", "type": "percent", "group": "Yield & Value" },
    { "id": "breakEvenOccupancy", "label": "Breakeven Occupancy", "type": "percent", "group": "Yield & Value" },
    { "id": "terminalValue", "label": "Terminal / Reversion Value", "type": "currency", "group": "Yield & Value" },
    { "id": "netSaleProceeds", "label": "Net Sale Proceeds", "type": "currency", "group": "Yield & Value" },
    { "id": "totalProfit", "label": "Total Profit", "type": "currency", "group": "Yield & Value" },
    { "id": "npv", "label": "Net Present Value", "type": "currency", "group": "Yield & Value" },
    { "id": "profitabilityIndex", "label": "Profitability Index", "type": "multiple", "group": "Yield & Value" },

    { "id": "minDscr", "label": "Min DSCR (lowest loan year)", "type": "multiple", "group": "Debt & Leverage" },
    { "id": "minMonthlyDscr", "label": "Min Monthly DSCR", "type": "multiple", "group": "Debt & Leverage" },
    { "id": "trendedYieldOnCost", "label": "Yield on Cost (trended — first stabilized year, with growth)", "type": "percent", "group": "Yield & Value" },
    { "id": "goingInDebtYield", "label": "Going-In Debt Yield (year-1 NOI)", "type": "percent", "group": "Debt & Leverage" },
    { "id": "avgDscr", "label": "Avg DSCR", "type": "multiple", "group": "Debt & Leverage" },
    { "id": "debtYield", "label": "Debt Yield (stabilized NOI)", "type": "percent", "group": "Debt & Leverage" },
    { "id": "ltv", "label": "LTV", "type": "percent", "group": "Debt & Leverage" },
    { "id": "ltc", "label": "LTC", "type": "percent", "group": "Debt & Leverage" },
    { "id": "loanConstant", "label": "Loan Constant", "type": "percent", "group": "Debt & Leverage" },
    { "id": "breakEvenRatio", "label": "Break-Even Ratio", "type": "percent", "group": "Debt & Leverage" },
    { "id": "interestCoverageRatio", "label": "Interest Coverage Ratio", "type": "multiple", "group": "Debt & Leverage" },
    { "id": "governingConstraint", "label": "Governing Sizing Constraint", "type": "text", "group": "Debt & Leverage" },
    { "id": "stressedDscr", "label": "Stressed DSCR (+200bps, NOI −10%)", "type": "multiple", "group": "Debt & Leverage" },
    { "id": "dscrAtCapStrike", "label": "DSCR at Cap Strike", "type": "multiple", "group": "Debt & Leverage" },
    { "id": "underwrittenDscr", "label": "Lender UW DSCR (NOI − reserves)", "type": "multiple", "group": "Debt & Leverage" },
    { "id": "breakEvenOccupancyYear1", "label": "Break-Even Occupancy (Yr 1)", "type": "percent", "group": "Debt & Leverage" },
    { "id": "breakEvenRentYear1", "label": "Break-Even Rent Level (Yr 1, % of scheduled)", "type": "percent", "group": "Debt & Leverage" }
  ],
  "sections": [
    {
      "id": "deal_basics",
      "label": "Deal Basics",
      "visibleWhen": null,
      "fields": [
        { "id": "dealName", "label": "Deal Name", "type": "text", "required": true },
        { "id": "investmentThesis", "label": "Investment Thesis (1–3 sentences, for the IC deck)", "type": "textarea" },
        { "id": "address", "label": "Address", "type": "text" },
        { "id": "market", "label": "Market", "type": "text" },
        { "id": "submarket", "label": "Submarket", "type": "text" },
        { "id": "dealType", "label": "Deal Type", "type": "select", "options": ["acquisition", "development"], "required": true, "default": "acquisition" },
        { "id": "propertyType", "label": "Property Type", "type": "select",
          "options": ["multifamily", "single_family", "townhouse", "retail", "industrial", "hotel", "office", "mixed_use", "other"],
          "required": true },
        { "id": "mixedUseComponents", "label": "Mixed-Use Components", "type": "multiselect",
          "options": ["multifamily", "retail", "industrial", "hotel", "office", "single_family", "townhouse"],
          "visibleWhen": { "all": [{ "field": "propertyType", "equals": "mixed_use" }] } }
      ]
    },
    {
      "id": "financing",
      "label": "Financing",
      "visibleWhen": null,
      "fields": [
        { "id": "totalCostBasis", "templateOnly": true, "label": "Purchase / Total Cost Basis", "type": "currency", "min": 0, "required": true },
        { "id": "ltvOrLtc", "label": "LTV / LTC", "type": "percent", "min": 0, "max": 1, "default": 0.65 },
        { "id": "loanAmount", "label": "Loan Amount", "type": "currency", "min": 0 },
        { "id": "interestRate", "label": "Interest Rate (fixed mode)", "type": "percent", "min": 0, "max": 0.25, "default": 0.065 },
        { "id": "rateMode", "label": "Rate Mode", "type": "select", "options": ["fixed", "floating"], "default": "fixed" },
        { "id": "currentIndexPct", "label": "Current Index (SOFR)", "type": "percent", "min": 0, "max": 0.15,
          "visibleWhen": { "all": [{ "field": "rateMode", "equals": "floating" }] } },
        { "id": "spreadBps", "label": "Spread (bps over index)", "type": "number", "min": 0, "max": 1500,
          "visibleWhen": { "all": [{ "field": "rateMode", "equals": "floating" }] } },
        { "id": "floorPct", "label": "Index Floor (blank = none)", "type": "percent", "min": 0, "max": 0.15,
          "visibleWhen": { "all": [{ "field": "rateMode", "equals": "floating" }] } },
        { "id": "forwardCurve", "label": "Forward Curve (index from month; step function, blank = flat at current)", "type": "table",
          "columns": [
            { "id": "month", "label": "From Month", "type": "number" },
            { "id": "indexPct", "label": "Index", "type": "percent" }
          ],
          "visibleWhen": { "all": [{ "field": "rateMode", "equals": "floating" }] } },
        { "id": "rateCapStrikePct", "label": "Rate Cap Strike (on the index)", "type": "percent", "min": 0, "max": 0.15,
          "visibleWhen": { "all": [{ "field": "rateMode", "equals": "floating" }] } },
        { "id": "rateCapTermMonths", "label": "Rate Cap Term (mo)", "type": "number", "min": 0, "max": 120,
          "visibleWhen": { "all": [{ "field": "rateMode", "equals": "floating" }] } },
        { "id": "rateCapPremium", "label": "Rate Cap Premium (paid at close)", "type": "currency", "min": 0,
          "visibleWhen": { "all": [{ "field": "rateMode", "equals": "floating" }] } },
        { "id": "amortYears", "label": "Amortization (yrs)", "type": "number", "min": 0, "max": 40, "default": 30 },
        { "id": "loanTermYears", "label": "Loan Term (yrs — refinanced at maturity if before exit; blank = no maturity)", "type": "number", "min": 0, "max": 40, "default": 10 },
        { "id": "ioMonths", "label": "Interest-Only Period (mo)", "type": "number", "min": 0, "default": 0 },
        { "id": "originationFeePct", "label": "Origination / Loan Fees", "type": "percent", "min": 0, "max": 0.05, "default": 0.01 },
        { "id": "monthsOfTaxesAndInsurance", "label": "Tax & Insurance Escrows (months, funded at close / released at exit)", "type": "number", "min": 0, "max": 24, "default": 0 },
        { "id": "dscrConstraint", "label": "Min DSCR Sizing Constraint (0 = off)", "type": "number", "min": 1, "max": 3, "zeroDisables": true, "default": 1.25 },
        { "id": "debtYieldConstraint", "label": "Min Debt Yield Sizing Constraint (0 = off)", "type": "percent", "min": 0, "max": 0.2, "zeroDisables": true, "default": 0.08 },
        { "id": "sizingNoiBasis", "label": "Sizing NOI Basis", "type": "select", "options": ["in_place", "stabilized", "underwritten"], "default": "stabilized" },
        { "id": "refiRateSpreadPct", "label": "Refi / Takeout Rate Spread (over the current loan rate)", "type": "percent", "min": -0.05, "max": 0.05, "default": 0 },
        { "id": "refiCostsPct", "label": "Refi / Takeout Costs (% of new loan)", "type": "percent", "min": 0, "max": 0.05, "default": 0.01 },
        { "id": "permanentLtvPct", "label": "Permanent Loan Max LTV (blank = same as LTC)", "type": "percent", "min": 0, "max": 1,
          "visibleWhen": { "all": [{ "field": "dealType", "equals": "development" }] } },
        { "id": "juniorTrancheKind", "label": "Junior Tranche", "type": "select",
          "options": ["none", "mezz", "pref_equity"], "default": "none" },
        { "id": "juniorAmount", "label": "Tranche Amount (0 = use fill-to-LTC)", "type": "currency", "min": 0,
          "visibleWhen": { "any": [{ "field": "juniorTrancheKind", "equals": "mezz" }, { "field": "juniorTrancheKind", "equals": "pref_equity" }] } },
        { "id": "juniorFillToLtcPct", "label": "Fill Combined Leverage To (% of cost)", "type": "percent", "min": 0, "max": 0.95,
          "visibleWhen": { "any": [{ "field": "juniorTrancheKind", "equals": "mezz" }, { "field": "juniorTrancheKind", "equals": "pref_equity" }] } },
        { "id": "juniorRatePct", "label": "Tranche Rate", "type": "percent", "min": 0, "max": 0.25,
          "visibleWhen": { "any": [{ "field": "juniorTrancheKind", "equals": "mezz" }, { "field": "juniorTrancheKind", "equals": "pref_equity" }] } },
        { "id": "juniorPayMode", "label": "Pay Mode", "type": "select", "options": ["current", "accrued"], "default": "current",
          "visibleWhen": { "any": [{ "field": "juniorTrancheKind", "equals": "mezz" }, { "field": "juniorTrancheKind", "equals": "pref_equity" }] } },
        { "id": "juniorOriginationFeePct", "label": "Tranche Origination Fee", "type": "percent", "min": 0, "max": 0.05,
          "visibleWhen": { "any": [{ "field": "juniorTrancheKind", "equals": "mezz" }, { "field": "juniorTrancheKind", "equals": "pref_equity" }] } }
      ]
    },
    {
      "id": "equity_structure",
      "label": "Equity Structure",
      "visibleWhen": null,
      "fields": [
        { "id": "totalEquity", "templateOnly": true, "label": "Total Equity", "type": "currency", "min": 0 },
        { "id": "lpSplitPct", "label": "LP Split", "type": "percent", "min": 0, "max": 1, "default": 0.9 },
        { "id": "gpSplitPct", "label": "GP Split", "type": "percent", "min": 0, "max": 1, "default": 0.1 },
        { "id": "preferredReturnPct", "label": "Preferred Return", "type": "percent", "min": 0, "max": 0.2, "default": 0.08 },
        { "id": "waterfallStyle", "label": "Waterfall Style", "type": "select",
          "options": ["european", "american"], "default": "european" },
        { "id": "assetMgmtFeePct", "label": "Asset Mgmt Fee (annual, to GP; partnership expense below NOI)", "type": "percent", "min": 0, "max": 0.05, "default": 0 },
        { "id": "assetMgmtFeeBasis", "label": "AM Fee Basis", "type": "select",
          "options": ["egi", "committed_equity"], "default": "egi",
          "visibleWhen": { "all": [{ "field": "assetMgmtFeePct", "notEmpty": true }] } },
        { "id": "catchUpPct", "label": "GP Catch-Up % (of profits during catch-up)", "type": "percent", "min": 0, "max": 1,
          "visibleWhen": { "all": [{ "field": "waterfallTiers", "notEmpty": true }] } },
        { "id": "waterfallTiers", "label": "Promote / Waterfall Tiers", "type": "table", "minRows": 2, "maxRows": 3,
          "columns": [
            { "id": "tierName", "label": "Tier", "type": "text" },
            { "id": "irrHurdle", "label": "IRR Hurdle", "type": "percent" },
            { "id": "lpSplitAboveHurdle", "label": "LP Split Above", "type": "percent" },
            { "id": "gpSplitAboveHurdle", "label": "GP Split Above (Promote)", "type": "percent" }
          ] }
      ]
    },
    {
      "id": "operating_income",
      "label": "Operating Income",
      "visibleWhen": null,
      "fields": [
        { "id": "grossPotentialRent", "label": "Gross Potential Rent", "type": "currency", "min": 0 },
        { "id": "vacancyPct", "label": "Vacancy", "type": "percent", "min": 0, "max": 1, "default": 0.05 },
        { "id": "creditLossPct", "label": "Credit Loss", "type": "percent", "min": 0, "max": 1, "default": 0.01 },
        { "id": "otherIncome", "label": "Other Income", "type": "currency", "min": 0 }
      ]
    },
    {
      "id": "operating_expenses",
      "label": "Operating Expenses",
      "visibleWhen": null,
      "fields": [
        { "id": "realEstateTaxes", "label": "Real Estate Taxes", "type": "currency", "min": 0 },
        { "id": "insurance", "label": "Insurance", "type": "currency", "min": 0 },
        { "id": "utilities", "label": "Utilities", "type": "currency", "min": 0 },
        { "id": "repairsMaintenance", "label": "Repairs & Maintenance", "type": "currency", "min": 0 },
        { "id": "payroll", "label": "Payroll", "type": "currency", "min": 0 },
        { "id": "generalAdmin", "label": "General & Admin", "type": "currency", "min": 0 },
        { "id": "managementFeePct", "label": "Management Fee", "type": "percent", "min": 0, "max": 0.2, "default": 0.03 },
        { "id": "replacementReserves", "label": "Replacement Reserves (flat $/yr, inside opex)", "type": "currency", "min": 0 },
        { "id": "replacementReservesPerUnit", "label": "Replacement Reserves ($/unit/yr)", "type": "currency", "min": 0 },
        { "id": "replacementReservesPsf", "label": "Replacement Reserves ($/SF/yr, commercial)", "type": "currency", "min": 0 },
        { "id": "reservesConvention", "label": "Reserves Convention", "type": "select",
          "options": ["below_noi", "above_noi_underwritten"], "default": "below_noi",
          "visibleWhen": { "any": [
            { "field": "replacementReservesPerUnit", "notEmpty": true },
            { "field": "replacementReservesPsf", "notEmpty": true }
          ] } },
        { "id": "opexLineItems", "label": "Opex Detail (overrides the fields above when any row exists)", "type": "table",
          "columns": [
            { "id": "category", "label": "Category", "type": "select",
              "options": ["taxes", "insurance", "utilities", "repairs_maintenance", "payroll", "management_fee", "ga", "other"] },
            { "id": "amount", "label": "Amount ($ or fraction for % of EGI)", "type": "number" },
            { "id": "basis", "label": "Basis", "type": "select",
              "options": ["annual_total", "per_unit", "psf", "pct_of_egi"] },
            { "id": "growthPct", "label": "Growth (blank = deal default)", "type": "percent" },
            { "id": "recoverable", "label": "Recoverable", "type": "select", "options": ["no", "yes"] },
            { "id": "variableWithOccupancy", "label": "Variable w/ Occupancy (blank = category default)", "type": "select", "options": ["", "no", "yes"] }
          ] },
        { "id": "opexAllocationBasis", "label": "Mixed-Use Opex Allocation", "type": "select",
          "options": ["revenue_share_y1", "sf", "revenue_share_annual"], "default": "revenue_share_y1",
          "visibleWhen": { "all": [{ "field": "propertyType", "equals": "mixed_use" }] } },
        { "id": "nonAdValoremTaxes", "label": "Non-Ad-Valorem Assessments (annual)", "type": "currency", "min": 0 },
        { "id": "nonAdValoremGrowthPct", "label": "Non-Ad-Valorem Growth (blank = expense growth)", "type": "percent", "min": -0.1, "max": 0.2,
          "visibleWhen": { "all": [{ "field": "nonAdValoremTaxes", "notEmpty": true }] } },
        { "id": "nonAdValoremRecoverable", "label": "Non-Ad-Valorem Recoverable", "type": "boolean", "default": true,
          "visibleWhen": { "all": [{ "field": "nonAdValoremTaxes", "notEmpty": true }] } },
        { "id": "useReassessedTaxes", "label": "Model Reassessed Property Taxes", "type": "boolean", "default": false },
        { "id": "millageRatePct", "label": "Millage Rate (total, e.g. 1.97%)", "type": "percent", "min": 0, "max": 0.05,
          "visibleWhen": { "all": [{ "field": "useReassessedTaxes", "equals": true }] } },
        { "id": "assessmentRatio", "label": "Assessed Value (% of purchase price)", "type": "percent", "min": 0.1, "max": 1.5, "default": 0.85,
          "visibleWhen": { "all": [{ "field": "useReassessedTaxes", "equals": true }] } },
        { "id": "reassessedTaxGrowthPct", "label": "Reassessed Tax Growth (blank = expense growth)", "type": "percent", "min": -0.1, "max": 0.2,
          "visibleWhen": { "all": [{ "field": "useReassessedTaxes", "equals": true }] } }
      ]
    },
    {
      "id": "renovation_program",
      "label": "Renovation Program (Value-Add)",
      "visibleWhen": { "any": [
        { "field": "propertyType", "equals": "multifamily" },
        { "field": "propertyType", "equals": "mixed_use" }
      ] },
      "fields": [
        { "id": "renovationProgram", "label": "Program (per unit type; blank = no program)", "type": "table",
          "columns": [
            { "id": "unitType", "label": "Unit Type (must match the mix)", "type": "text" },
            { "id": "unitsToReno", "label": "# Units", "type": "number" },
            { "id": "costPerUnit", "label": "Cost / Unit", "type": "currency" },
            { "id": "premiumPerMonth", "label": "Premium ($/mo)", "type": "currency" },
            { "id": "downtimeMonthsPerUnit", "label": "Downtime (mo/unit)", "type": "number" },
            { "id": "unitsPerMonth", "label": "Pace (units/mo)", "type": "number" },
            { "id": "startMonth", "label": "Start (operating month)", "type": "number" }
          ] },
        { "id": "renoFundingSource", "label": "Funding", "type": "select",
          "options": ["equity_at_close", "operating_cash"], "default": "equity_at_close",
          "visibleWhen": { "all": [{ "field": "renovationProgram", "notEmpty": true }] } }
      ]
    },
    {
      "id": "growth_assumptions",
      "label": "Growth Assumptions",
      "visibleWhen": null,
      "fields": [
        { "id": "rentGrowthMode", "label": "Rent Growth Mode", "type": "select", "options": ["flat", "per_year"], "default": "per_year" },
        { "id": "rentGrowthPct", "label": "Rent Growth", "type": "percent", "min": -0.1, "max": 0.2, "default": 0.03 },
        { "id": "expenseGrowthMode", "label": "Expense Growth Mode", "type": "select", "options": ["flat", "per_year"], "default": "per_year" },
        { "id": "expenseGrowthPct", "label": "Expense Growth", "type": "percent", "min": -0.1, "max": 0.2, "default": 0.025 }
      ]
    },
    {
      "id": "exit_assumptions",
      "label": "Exit Assumptions",
      "visibleWhen": null,
      "fields": [
        { "id": "holdPeriodYears", "label": "Hold Period (yrs)", "type": "number", "min": 1, "max": 30, "default": 5 },
        { "id": "analysisStartDate", "label": "Analysis Start / Closing Date (blank = Jan 1, 2026)", "type": "date" },
        { "id": "exitCapRatePct", "label": "Exit / Terminal Cap Rate", "type": "percent", "min": 0, "max": 0.2, "default": 0.06 },
        { "id": "costOfSalePct", "label": "Cost of Sale", "type": "percent", "min": 0, "max": 0.1, "default": 0.02 },
        { "id": "discountRatePct", "label": "Discount Rate (NPV)", "type": "percent", "min": 0, "max": 0.3, "default": 0.1 },
        { "id": "irrConvention", "label": "IRR Convention", "type": "select",
          "options": ["periodic_monthly", "xirr"], "default": "periodic_monthly" },
        { "id": "residentialExitCapPct", "label": "Residential Exit Cap (mixed-use)", "type": "percent", "min": 0, "max": 0.2,
          "visibleWhen": { "all": [{ "field": "propertyType", "equals": "mixed_use" }] } },
        { "id": "commercialExitCapPct", "label": "Commercial Exit Cap (mixed-use)", "type": "percent", "min": 0, "max": 0.2,
          "visibleWhen": { "all": [{ "field": "propertyType", "equals": "mixed_use" }] } }
      ]
    },
    {
      "id": "acquisition_specific",
      "label": "Acquisition Details",
      "visibleWhen": { "all": [{ "field": "dealType", "equals": "acquisition" }] },
      "fields": [
        { "id": "purchasePrice", "label": "Purchase Price", "type": "currency", "min": 0, "required": true },
        { "id": "closingCostsPct", "label": "Closing Costs", "type": "percent", "min": 0, "max": 0.1, "default": 0.02 },
        { "id": "dueDiligenceCosts", "label": "Due Diligence Costs", "type": "currency", "min": 0 },
